# Copie este arquivo para .env e preencha os valores.
# O .env e ignorado pelo git e carregado automaticamente pela aplicacao.

# --- Banco de dados (PostgreSQL do Aiven em producao) ---
# O Aiven exige SSL: inclua ?sslmode=require na URL
DB_URL=jdbc:postgresql://HOST:PORT/DB_NAME?sslmode=require
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# --- JWT ---
# Chave Base64 com no minimo 32 bytes. Gere com: openssl rand -base64 32
JWT_SECRET=SUA_CHAVE_BASE64_DE_32_BYTES

# --- Usuario admin criado na primeira execucao ---
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=SUA_SENHA_ADMIN

# --- CORS: origens permitidas, separadas por virgula ---
CORS_ALLOWED_ORIGINS=https://seu-frontend.onrender.com,http://localhost:5173
